# IronStock Production Environment
# Copy to .env.prod and fill in your values:
#   cp .env.prod.example .env.prod

# Domain (used for CORS and Caddy)
DOMAIN=haslaman.tplinkdns.com

# PostgreSQL
POSTGRES_USER=ironstock
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ironstock

# Encryption keys (generate with: openssl rand -base64 32)
MASTER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# MinIO (S3-compatible storage)
MINIO_ACCESS_KEY=ironstock-minio
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

# SMTP (optional — for password reset emails)
SMTP_HOST=
SMTP_PORT=587

# Bootstrap mode (set to true on FIRST RUN ONLY, then set to false)
BOOTSTRAP_ENABLED=true
