# Public — Full app: Web UI + API + WebSocket + SCIM
# Let's Encrypt auto-SSL via Caddy.
haslaman.tplinkdns.com {
	handle /api/* {
		reverse_proxy server:8080
	}

	handle /scim/* {
		reverse_proxy server:8080
	}

	handle /metrics {
		respond "Forbidden" 403
	}

	handle {
		reverse_proxy web:80
	}
}

