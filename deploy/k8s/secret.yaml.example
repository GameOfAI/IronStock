# TEMPLATE — Gerçek secret.yaml için kopyala + doldur + kubectl apply yap; COMMIT ETME.
# secret.yaml dosyası .gitignore'da tanımlıdır.
#
# --- ÖNERİLEN YÖNTEM (Sealed Secrets) ---
# Sealed Secrets kuruluysa plaintext secret.yaml oluşturup şifrele:
#   cp deploy/k8s/secret.yaml.example deploy/k8s/secret.yaml
#   # Değerleri doldur (aşağıda openssl komutları)
#   make seal-secret
#   git add deploy/k8s/secret.sealed.yaml && git commit -m "chore(deploy): update sealed secret"
#
# Detaylar: docs/ops/sealed-secrets.md
#
# --- MANUEL YÖNTEM (Sealed Secrets yoksa) ---
# kubectl create secret generic envanter-secret \
#   -n envanter \
#   --from-literal=ENVANTER_MASTER_KEY="$(openssl rand -base64 32)" \
#   --from-literal=ENVANTER_JWT_SECRET="$(openssl rand -base64 32)" \
#   --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24)" \
#   --from-literal=ENVANTER_DB_URL="postgres://envanter:<POSTGRES_PASSWORD>@postgres:5432/envanter?sslmode=disable"
#
# --- Key Açıklamaları ---
# ENVANTER_MASTER_KEY : Server-side envelope şifreleme için master key (32B, base64)
# ENVANTER_JWT_SECRET : JWT access/refresh token imzalama (32B, base64)
# POSTGRES_PASSWORD   : PostgreSQL envanter kullanıcısı şifresi (24B, base64)
# ENVANTER_DB_URL     : Full Postgres connection string (POSTGRES_PASSWORD içerir)

apiVersion: v1
kind: Secret
metadata:
  name: envanter-secret
  namespace: envanter
type: Opaque
stringData:
  ENVANTER_MASTER_KEY: "<openssl rand -base64 32>"
  ENVANTER_JWT_SECRET: "<openssl rand -base64 32>"
  POSTGRES_PASSWORD: "<openssl rand -base64 24>"
  ENVANTER_DB_URL: "postgres://envanter:<POSTGRES_PASSWORD>@postgres:5432/envanter?sslmode=disable"
