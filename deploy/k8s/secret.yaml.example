# Bu bir TEMPLATE'dir. Gerçek secret.yaml git'te yoktur (.gitignore).
# Kopyala + yeni secret üret + kubectl apply yap; commit ETME.
#
# Yeni secret üret (32B random base64):
#   openssl rand -base64 32
#
# Veya tek seferlik kubectl ile (önerilen):
#   kubectl create secret generic envanter-secret \
#     -n envanter \
#     --from-literal=ENVANTER_MASTER_KEY="$(openssl rand -base64 32)" \
#     --from-literal=ENVANTER_JWT_SECRET="$(openssl rand -base64 32)" \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=ENVANTER_DB_URL="postgres://envanter:<POSTGRES_PASSWORD>@postgres:5432/envanter?sslmode=disable"

apiVersion: v1
kind: Secret
metadata:
  name: envanter-secret
  namespace: envanter
type: Opaque
stringData:
  ENVANTER_MASTER_KEY: "<generate-with-openssl-rand-base64-32>"
  ENVANTER_JWT_SECRET: "<generate-with-openssl-rand-base64-32>"
  POSTGRES_PASSWORD: "<generate-with-openssl-rand-base64-24>"
  ENVANTER_DB_URL: "postgres://envanter:<POSTGRES_PASSWORD>@postgres:5432/envanter?sslmode=disable"
