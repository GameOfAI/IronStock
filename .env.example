# Envanter App — Geliştirici ortam değişkenleri örneği.
# Kopyala: cp .env.example .env
# .env gitignore'da, asla commit edilmez.

# Server
ENVANTER_ADDR=:8080
ENVANTER_LOG_LEVEL=debug

# Database (docker-compose stack ile eşleşir)
ENVANTER_DB_URL=postgres://envanter:envanter_dev@localhost:5432/envanter?sslmode=disable

# SMTP (Mailhog — dev only)
ENVANTER_SMTP_HOST=localhost
ENVANTER_SMTP_PORT=1025
ENVANTER_SMTP_FROM=noreply@envanter.local

# Master encryption key — Faz 1+ (32 byte base64-encoded)
# Prod'da KMS/External Secrets'tan gelir. Dev için rastgele üret:
#   openssl rand -base64 32
ENVANTER_MASTER_KEY=

# JWT signing key — Faz 2+ (32 byte base64-encoded)
ENVANTER_JWT_SECRET=
