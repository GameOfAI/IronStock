# Dev Dockerfile for server
# Must match server/go.mod's `go 1.25.0` — golang images set GOTOOLCHAIN=local,
# so an older base fails `go mod download` ("requires go >= 1.25.0").
FROM golang:1.26-alpine

WORKDIR /app

# Copy go mod files
COPY server/go.mod server/go.sum ./

# Download dependencies
RUN go mod download

# Copy server source
COPY server/ .

# Build
RUN go build -o bin/api ./cmd/api

# Run
EXPOSE 8080
CMD ["./bin/api"]
