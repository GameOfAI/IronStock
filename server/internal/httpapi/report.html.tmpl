<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{.Title}}</title>
<style>
  /* ── Reset + Base ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
         font-size: 13px; color: #1a1a2e; background: #f8f9fa; line-height: 1.5; }

  /* ── Layout ── */
  .page { max-width: 1100px; margin: 0 auto; padding: 24px 16px; }

  /* ── Header ── */
  .report-header { background: #1e293b; color: #f1f5f9; padding: 28px 32px;
                   border-radius: 8px; margin-bottom: 24px; }
  .report-header h1 { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
  .report-meta { font-size: 12px; opacity: .75; }
  .report-meta span { margin-right: 20px; }
  .badge { display:inline-block; padding:2px 8px; border-radius:4px; font-size:11px;
           font-weight:600; margin-left:6px; }
  .badge-blue { background:#dbeafe; color:#1e40af; }
  .badge-green { background:#dcfce7; color:#166534; }
  .badge-amber { background:#fef9c3; color:#92400e; }
  .badge-red   { background:#fee2e2; color:#991b1b; }
  .badge-gray  { background:#f3f4f6; color:#374151; }

  /* ── Item card ── */
  .item-card { background:#fff; border:1px solid #e5e7eb; border-radius:8px;
               margin-bottom:20px; overflow:hidden; }
  .item-header { padding:14px 18px; background:#f8fafc; border-bottom:1px solid #e5e7eb;
                 display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .item-title { font-size:15px; font-weight:700; flex:1; min-width:0;
                white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .item-type  { font-size:11px; font-weight:600; color:#6b7280;
                background:#f3f4f6; padding:2px 8px; border-radius:4px; }
  .item-body  { padding:16px 18px; }

  /* ── Metadata table ── */
  .meta-table { width:100%; border-collapse:collapse; font-size:12px; }
  .meta-table td { padding:4px 8px; vertical-align:top; }
  .meta-table td:first-child { color:#6b7280; font-weight:600; width:130px;
                                white-space:nowrap; }
  .meta-table td:last-child  { color:#1f2937; }

  /* ── Tags ── */
  .tags { display:flex; flex-wrap:wrap; gap:4px; }
  .tag { font-size:11px; padding:1px 7px; border-radius:12px; background:#e0f2fe;
         color:#0369a1; }

  /* ── Section ── */
  .section { margin-top:16px; }
  .section-title { font-size:12px; font-weight:700; color:#374151;
                   text-transform:uppercase; letter-spacing:.06em;
                   margin-bottom:8px; padding-bottom:4px;
                   border-bottom:2px solid #e5e7eb; }

  /* ── Data table ── */
  .data-table { width:100%; border-collapse:collapse; font-size:12px; }
  .data-table th { background:#f3f4f6; padding:5px 10px; text-align:left;
                   font-weight:600; color:#374151; border-bottom:1px solid #d1d5db; }
  .data-table td { padding:5px 10px; border-bottom:1px solid #f3f4f6;
                   vertical-align:top; }
  .data-table tr:last-child td { border-bottom:none; }
  .data-table tr:hover td  { background:#fafafa; }

  /* ── Status indicators ── */
  .status-dot { display:inline-block; width:8px; height:8px; border-radius:50%;
                margin-right:5px; }
  .dot-green  { background:#22c55e; }
  .dot-amber  { background:#f59e0b; }
  .dot-red    { background:#ef4444; }
  .dot-gray   { background:#9ca3af; }

  /* ── CPU / Memory bar ── */
  .metric-bar-wrap { display:flex; align-items:center; gap:6px; }
  .metric-bar { flex:1; height:8px; border-radius:4px; background:#e5e7eb;
                overflow:hidden; min-width:60px; }
  .metric-fill { height:100%; border-radius:4px; transition:width .3s; }
  .fill-green  { background:#22c55e; }
  .fill-amber  { background:#f59e0b; }
  .fill-red    { background:#ef4444; }
  .metric-label { font-size:11px; color:#6b7280; white-space:nowrap; }

  /* ── Warning event ── */
  .event-warning td { background:#fff7ed; color:#92400e; }
  .event-warning td:first-child { border-left:3px solid #f59e0b; }

  /* ── Relationships ── */
  .rel-list { list-style:none; display:flex; flex-direction:column; gap:4px; }
  .rel-item { display:flex; align-items:center; gap:8px; font-size:12px; }
  .rel-type  { font-size:10px; font-weight:600; color:#6366f1; background:#eef2ff;
               padding:1px 6px; border-radius:3px; white-space:nowrap; }

  /* ── Error box ── */
  .fetch-error { background:#fff1f2; border:1px solid #fecdd3; border-radius:6px;
                 padding:10px 14px; color:#9f1239; font-size:12px; }

  /* ── Footer ── */
  .report-footer { text-align:center; font-size:11px; color:#9ca3af;
                   padding:20px 0 8px; border-top:1px solid #e5e7eb; margin-top:28px; }

  /* ── Print ── */
  @media print {
    body { background:#fff; }
    .item-card { break-inside:avoid; box-shadow:none; border:1px solid #ccc; }
    .report-header { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  }
</style>
</head>
<body>
<div class="page">

  <!-- ── Header ── -->
  <div class="report-header">
    <h1>{{.Title}}</h1>
    <div class="report-meta">
      <span>📅 {{.GeneratedAt}}</span>
      <span>📦 {{.ItemCount}} item</span>
      {{if .Options.IncludeK8sLive}}<span><span class="badge badge-green">K8s Canlı Veri</span></span>{{end}}
      {{if .Options.IncludeRelationships}}<span><span class="badge badge-blue">İlişkiler</span></span>{{end}}
    </div>
  </div>

  <!-- ── Items ── -->
  {{range .Items}}
  <div class="item-card">

    <!-- Item header -->
    <div class="item-header">
      <span class="item-title">{{.Name}}</span>
      {{if .ItemType}}<span class="item-type">{{.ItemType}}</span>{{end}}
      {{range .Tags}}<span class="badge badge-gray">{{.}}</span>{{end}}
      {{if .ExpiresAt}}
        <span class="badge badge-amber">⏰ {{formatTime .ExpiresAt}}</span>
      {{end}}
    </div>

    <div class="item-body">

      <!-- Metadata -->
      <table class="meta-table">
        {{if .FolderPath}}<tr><td>Klasör</td><td>{{.FolderPath}}</td></tr>{{end}}
        {{if .Description}}<tr><td>Açıklama</td><td>{{.Description}}</td></tr>{{end}}
        <tr><td>Oluşturulma</td><td>{{formatTime .CreatedAt}}</td></tr>
        <tr><td>Güncelleme</td><td>{{formatTime .UpdatedAt}}</td></tr>
      </table>

      <!-- Relationships -->
      {{if .RelatedItems}}
      <div class="section">
        <div class="section-title">İlişkiler</div>
        <ul class="rel-list">
          {{range .RelatedItems}}
          <li class="rel-item">
            <span class="rel-type">{{.RelType}}</span>
            <span>{{if .TargetName}}{{.TargetName}}{{else}}{{.TargetID}}{{end}}</span>
          </li>
          {{end}}
        </ul>
      </div>
      {{end}}

      <!-- Live K8s Data -->
      {{if .K8sData}}
      <div class="section">
        <div class="section-title">
          Kubernetes — {{.K8sData.Namespace}}
          {{if .K8sData.ClusterName}}<span style="font-weight:400;text-transform:none;color:#6b7280"> · {{.K8sData.ClusterName}}</span>{{end}}
        </div>

        {{if .K8sData.FetchError}}
          <div class="fetch-error">⚠️ K8s verisi alınamadı: {{.K8sData.FetchError}}</div>
        {{else}}

          <!-- Pods -->
          {{if .K8sData.Pods}}
          <div style="margin-bottom:14px">
            <div style="font-size:11px;font-weight:600;color:#6b7280;margin-bottom:5px;text-transform:uppercase;">
              Pods ({{len .K8sData.Pods}})
            </div>
            <table class="data-table">
              <thead>
                <tr><th>Pod</th><th>Durum</th><th>Node</th><th>Yeniden Başlatma</th><th>CPU</th><th>Bellek</th></tr>
              </thead>
              <tbody>
                {{range .K8sData.Pods}}
                <tr>
                  <td>{{.Metadata.Name}}</td>
                  <td>
                    {{if eq .Status.Phase "Running"}}
                      <span class="status-dot dot-green"></span>
                    {{else if eq .Status.Phase "Pending"}}
                      <span class="status-dot dot-amber"></span>
                    {{else if eq .Status.Phase "Failed"}}
                      <span class="status-dot dot-red"></span>
                    {{else}}
                      <span class="status-dot dot-gray"></span>
                    {{end}}
                    {{.Status.Phase}}
                  </td>
                  <td>{{.Status.NodeName}}</td>
                  <td>
                    {{range .Status.ContainerStatuses}}{{.RestartCount}}{{end}}
                  </td>
                  <td>—</td>
                  <td>—</td>
                </tr>
                {{end}}
              </tbody>
            </table>
          </div>
          {{end}}

          <!-- Deployments -->
          {{if .K8sData.Deployments}}
          <div style="margin-bottom:14px">
            <div style="font-size:11px;font-weight:600;color:#6b7280;margin-bottom:5px;text-transform:uppercase;">
              Deployments ({{len .K8sData.Deployments}})
            </div>
            <table class="data-table">
              <thead>
                <tr><th>Deployment</th><th>İstenen</th><th>Hazır</th><th>Uygun</th><th>Durum</th></tr>
              </thead>
              <tbody>
                {{range .K8sData.Deployments}}
                <tr>
                  <td>{{.Metadata.Name}}</td>
                  <td>{{.Spec.Replicas}}</td>
                  <td>{{.Status.ReadyReplicas}}</td>
                  <td>{{.Status.AvailableReplicas}}</td>
                  <td>
                    {{if eq .Status.ReadyReplicas .Spec.Replicas}}
                      <span class="status-dot dot-green"></span>Sağlıklı
                    {{else if gt .Status.ReadyReplicas 0}}
                      <span class="status-dot dot-amber"></span>Kısmi
                    {{else}}
                      <span class="status-dot dot-red"></span>Hazır Değil
                    {{end}}
                  </td>
                </tr>
                {{end}}
              </tbody>
            </table>
          </div>
          {{end}}

          <!-- Services -->
          {{if .K8sData.Services}}
          <div style="margin-bottom:14px">
            <div style="font-size:11px;font-weight:600;color:#6b7280;margin-bottom:5px;text-transform:uppercase;">
              Services ({{len .K8sData.Services}})
            </div>
            <table class="data-table">
              <thead>
                <tr><th>Service</th><th>Tür</th><th>ClusterIP</th><th>Port(lar)</th></tr>
              </thead>
              <tbody>
                {{range .K8sData.Services}}
                <tr>
                  <td>{{.Metadata.Name}}</td>
                  <td>{{.Spec.Type}}</td>
                  <td>{{.Spec.ClusterIP}}</td>
                  <td>
                    {{range .Spec.Ports}}{{.Port}}/{{.Protocol}} {{end}}
                  </td>
                </tr>
                {{end}}
              </tbody>
            </table>
          </div>
          {{end}}

          <!-- Metrics -->
          {{if .K8sData.Metrics}}
          <div style="margin-bottom:14px">
            <div style="font-size:11px;font-weight:600;color:#6b7280;margin-bottom:5px;text-transform:uppercase;">
              CPU / Bellek
            </div>
            <table class="data-table">
              <thead>
                <tr><th>Pod</th><th>Container</th><th>CPU</th><th>Bellek</th></tr>
              </thead>
              <tbody>
                {{range .K8sData.Metrics}}
                {{$podName := .Metadata.Name}}
                {{range .Containers}}
                <tr>
                  <td>{{$podName}}</td>
                  <td>{{.Name}}</td>
                  <td>
                    {{$cpu := index .Usage "cpu"}}
                    {{if $cpu}}
                    <div class="metric-bar-wrap">
                      <div class="metric-bar">
                        {{$pct := metricPercent $cpu}}
                        <div class="metric-fill {{if gt $pct 80}}fill-red{{else if gt $pct 60}}fill-amber{{else}}fill-green{{end}}"
                             style="width:{{$pct}}%"></div>
                      </div>
                      <span class="metric-label">{{$cpu}}</span>
                    </div>
                    {{else}}—{{end}}
                  </td>
                  <td>
                    {{$mem := index .Usage "memory"}}
                    {{if $mem}}
                    <div class="metric-bar-wrap">
                      <div class="metric-bar">
                        {{$pct := metricPercent $mem}}
                        <div class="metric-fill {{if gt $pct 80}}fill-red{{else if gt $pct 60}}fill-amber{{else}}fill-green{{end}}"
                             style="width:{{$pct}}%"></div>
                      </div>
                      <span class="metric-label">{{$mem}}</span>
                    </div>
                    {{else}}—{{end}}
                  </td>
                </tr>
                {{end}}
                {{end}}
              </tbody>
            </table>
          </div>
          {{end}}

          <!-- Warning Events -->
          {{if .K8sData.Events}}
          <div style="margin-bottom:6px">
            <div style="font-size:11px;font-weight:600;color:#b45309;margin-bottom:5px;text-transform:uppercase;">
              ⚠ Uyarı Eventleri ({{len .K8sData.Events}})
            </div>
            <table class="data-table">
              <thead>
                <tr><th>Nesne</th><th>Sebep</th><th>Mesaj</th><th>Sayı</th><th>Son Görülme</th></tr>
              </thead>
              <tbody>
                {{range .K8sData.Events}}
                <tr class="event-warning">
                  <td>{{.InvolvedObject.Name}}</td>
                  <td>{{.Reason}}</td>
                  <td>{{.Message}}</td>
                  <td>{{.Count}}</td>
                  <td>{{.LastTimestamp}}</td>
                </tr>
                {{end}}
              </tbody>
            </table>
          </div>
          {{end}}

        {{end}}{{/* end if FetchError */}}
      </div>
      {{end}}{{/* end if K8sData */}}

    </div>{{/* item-body */}}
  </div>{{/* item-card */}}
  {{end}}{{/* range Items */}}

  <!-- ── Footer ── -->
  <div class="report-footer">
    Generated by <strong>IronStock</strong> · {{.GeneratedAt}}
  </div>

</div>
</body>
</html>
