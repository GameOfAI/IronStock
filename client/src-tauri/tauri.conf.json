{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Envanter",
  "version": "0.1.0",
  "identifier": "app.envanter.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Envanter",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "Utility",
    "shortDescription": "Envanter yönetim uygulaması",
    "longDescription": "DevOps/SRE takımları için merkezi envanter yönetim uygulaması."
  }
}
